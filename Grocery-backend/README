### cheapest nearest store


## first add env values 

# Default provider when payload doesn't specify
DISTANCE_PROVIDER_DEFAULT=haversine

# Allow payload to request google/haversine at runtime
ALLOW_DISTANCE_PROVIDER_OVERRIDE=true

# Google settings (only required if using google)
GOOGLE_MAPS_API_KEY=YOUR_KEY
GOOGLE_MAPS_DEFAULT_MODE=driving

# Travel cost defaults
DEFAULT_COST_PER_KM=80
DEFAULT_COST_PER_MIN=12
DEFAULT_COST_MODEL=distance

# Fallback behavior
FALLBACK_TO_HAVERSINE=true



### api endpoint
curl -X POST http://127.0.0.1:5000/recommend/store \
  -H "Content-Type: application/json" \
  -d '{
    "items": [{"clean_product_id": 49, "qty": 1}],
    "user_location": {"lat": 6.9271, "lng": 79.8612},
    "travel": {"mode":"driving","provider":"haversine","cost_model":"distance"}
  }'



  ### possible modes to run
  "travel": {"mode":"driving","provider":"haversine","cost_model":"distance"}
  "travel": {"mode":"driving","provider":"google","cost_model":"time"}

  ### for google we can change mode
   "travel": {"mode":"walking","provider":"google","cost_model":"time"}
   "travel": {"mode":"bicycling","provider":"google"} ## env has default cost model


