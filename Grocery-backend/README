## predict and store
python -m src.ml.predict_and_store --model-path models/ml_v1.joblib --model-version ml_v1


-- per store
python -m src.ml.predict_and_store --store cargills


## activate ML when needed  - dont run this yet - can use next iteration of changes.
UPDATE product_categories ml
SET is_active = TRUE
FROM product_categories rules
WHERE ml.clean_product_id = rules.clean_product_id
  AND ml.model_version = 'ml_v1'
  AND rules.model_version = 'rules_v1'
  AND rules.is_active = TRUE
  AND rules.category_l2 = 'unknown'
  AND ml.confidence >= 0.80;


## How many ML rows inserted?
SELECT COUNT(*)
FROM product_categories
WHERE model_version = 'ml_v1';


## Average confidence
SELECT AVG(confidence)
FROM product_categories
WHERE model_version = 'ml_v1';


### get model accuracy
python -m src.ml.predict_and_store --eval-against rules_v1 --eval-only --report


- just for cargills
python -m src.ml.predict_and_store --store cargills --eval-against rules_v1 --eval-only






