## sql validation
--show samples with name

SELECT
  cp.canonical_name,
  pn.category_l2,
  pn.energy_kcal_per_100g,
  pn.protein_g_per_100g
FROM product_nutrition pn
JOIN clean_products cp ON cp.clean_product_id = pn.clean_product_id
WHERE pn.model_version='rules_v1'
ORDER BY pn.product_nutrition_id DESC
LIMIT 20;



